// Cloudflare Workers 設定檔
// D1 binding 名稱為 "DB"，必須與 src/worker/index.ts 中的 c.env.DB 一致
{
	"name": "todo-cloudflare-app",
	"compatibility_date": "2026-10-01",
	"main": "src/worker/index.ts",
	"assets": {
		// 前端靜態檔由 @cloudflare/vite-plugin 自動處理，不需指定 directory
		"not_found_handling": "single-page-application",
		// API 路由優先交給 Worker 處理，其餘走靜態資產
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "todo-db",
			"database_id": "baed43b9-1e15-4841-975b-e1f8f0d74510",
			"migrations_dir": "migrations"
		}
	]
}
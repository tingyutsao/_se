// Cloudflare Workers 設定檔
// 部署前請先執行 `npx wrangler d1 create todo-db`，
// 並把輸出的 database_id 填到下面 D1 設定中。
{
  "name": "todo-cloudflare-app",
  "compatibility_date": "2026-10-01",
  "main": "src/worker/index.ts",
  "assets": {
    // 前端靜態檔由 @cloudflare/vite-plugin 自動處理，不需指定 directory
    "not_found_handling": "single-page-application",
    // API 路由優先交給 Worker 處理，其餘走靜態資產
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "todo-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      // 建立資料庫後填入，例如 "database_id": "a1b2c3d4-...."
      "migrations_dir": "migrations"
    }
  ]
}
